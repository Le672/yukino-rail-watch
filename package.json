{
  "name": "yukino-rail-watch",
  "private": true,
  "version": "1.10.7",
  "type": "module",
  "main": "electron/rail-main.cjs",
  "description": "12306 余票查询与 Windows 通知",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop:build": "pnpm build && node node_modules/electron-builder/out/cli/cli.js --config electron-builder.json --win portable",
    "mobile:build": "tsc --noEmit && vite build --config vite.mobile.config.ts && node scripts/finalize-mobile.mjs",
    "mobile:sync": "pnpm mobile:build && cap sync && node scripts/configure-mobile.mjs",
    "mobile:android": "pnpm mobile:sync && cap open android",
    "mobile:ios": "pnpm mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "coordtransform": "2.1.2",
    "leaflet": "1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "1.9.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.115.0"
  },
  "author": "Yukino"
}
